<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:SciLors_Mashed_Trainer.Controls"
        x:Class="SciLors_Mashed_Trainer.MainWindow"
        Title="SciLor's Mashed Trainer v0.2.0"
        Width="1330" Height="700"
        MinWidth="1200" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Name="mniExit" Header="E_xit" Click="mniExit_Click" />
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem Name="mniWebsite" Header="_Website" Click="mniWebsite_Click" />
                <MenuItem Name="mniDonate" Header="_Donate" Click="mniDonate_Click" />
                <Separator />
                <MenuItem Name="mniMockToggle" Header="Toggle _Mock Game Mode" Click="mniMockToggle_Click" />
            </MenuItem>
        </Menu>

        <!-- Main Tabs -->
        <TabControl Name="tabMain" Grid.Row="1" Margin="4">
            <TabItem Header="Players" Name="taiPlayers">
                <Grid Name="grdPlayers" ColumnDefinitions="*,*,*,*">
                    <!-- Populated dynamically or statically with 4 UcPlayerInfo -->
                </Grid>
            </TabItem>
            <TabItem Header="Game" Name="taiGame">
                <uc:UcGameInfo x:Name="ucGameInfo" />
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#13151B" Padding="10,4" BorderBrush="#252936" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Name="elpStatusLed" Width="8" Height="8" Fill="#FFA000" VerticalAlignment="Center" />
                <TextBlock Name="txtStatus" Text="Waiting for Mashed (MFL.exe)..." FontSize="11" Foreground="#9DA7B8" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
